{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "authoring/**/*.ts", "runtime-refs/**/*.ts", "conformance/**/*.ts", "test/**/*.test.ts"]
}
