[
  {
    "id": "balancer-v1:sum-weights",
    "version": 1,
    "program": [
      {
        "assert": {
          "op": "lte",
          "args": [
            {
              "op": "length",
              "args": [
                "$input"
              ]
            },
            8
          ]
        },
        "error": "weight vector bound"
      },
      {
        "return": {
          "op": "sumUint",
          "args": [
            "$input"
          ]
        }
      }
    ]
  },
  {
    "id": "univ4-fee-hook:sat1-hook-data",
    "version": 1,
    "program": [
      {
        "let": "buyer",
        "value": {
          "op": "address",
          "args": [
            "$input.executor"
          ]
        }
      },
      {
        "let": "hook",
        "value": {
          "op": "address",
          "args": [
            "$input.hook"
          ]
        }
      },
      {
        "assert": {
          "op": "or",
          "args": [
            {
              "op": "eq",
              "args": [
                "$input.direction",
                "zero-for-one"
              ]
            },
            {
              "op": "eq",
              "args": [
                "$input.direction",
                "one-for-zero"
              ]
            }
          ]
        },
        "error": "invalid execution direction"
      },
      {
        "let": "seller",
        "value": {
          "op": "address",
          "args": [
            {
              "op": "bytes",
              "args": [
                {
                  "op": "packedHash",
                  "args": [
                    [
                      "string",
                      "address",
                      "address"
                    ],
                    [
                      "univ4-fee-hook:sat1:sell:v1",
                      "$buyer",
                      "$hook"
                    ]
                  ]
                },
                12,
                20
              ]
            }
          ]
        }
      },
      {
        "assert": {
          "op": "and",
          "args": [
            {
              "op": "not",
              "args": [
                {
                  "op": "sameAddress",
                  "args": [
                    "$seller",
                    "$buyer"
                  ]
                }
              ]
            },
            {
              "op": "not",
              "args": [
                {
                  "op": "sameAddress",
                  "args": [
                    "$seller",
                    "0x0000000000000000000000000000000000000000"
                  ]
                }
              ]
            }
          ]
        },
        "error": "derived actor collision"
      },
      {
        "return": {
          "hookData": {
            "op": "abiEncode",
            "args": [
              [
                "address"
              ],
              [
                {
                  "op": "if",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        "$input.direction",
                        "zero-for-one"
                      ]
                    },
                    "$buyer",
                    "$seller"
                  ]
                }
              ]
            ]
          }
        }
      }
    ]
  },
  {
    "id": "ekubo:core-swap-log",
    "version": 1,
    "program": [
      {
        "assert": {
          "op": "matches",
          "args": [
            "$input.balanceUpdate",
            "^0x[0-9a-fA-F]{64}$"
          ]
        },
        "error": "packed balance update word"
      },
      {
        "let": "packed",
        "value": {
          "op": "uint",
          "args": [
            "$input.balanceUpdate"
          ]
        }
      },
      {
        "let": "delta0",
        "value": {
          "op": "signedWord",
          "args": [
            {
              "op": "shrUint",
              "args": [
                "$packed",
                {
                  "op": "uint",
                  "args": [
                    "128"
                  ]
                }
              ]
            },
            {
              "op": "uint",
              "args": [
                "128"
              ]
            }
          ]
        }
      },
      {
        "let": "delta1",
        "value": {
          "op": "signedWord",
          "args": [
            {
              "op": "andUint",
              "args": [
                "$packed",
                {
                  "op": "uint",
                  "args": [
                    "340282366920938463463374607431768211455"
                  ]
                }
              ]
            },
            {
              "op": "uint",
              "args": [
                "128"
              ]
            }
          ]
        }
      },
      {
        "assert": {
          "op": "not",
          "args": [
            {
              "op": "or",
              "args": [
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "gt",
                      "args": [
                        "$delta0",
                        {
                          "op": "uint",
                          "args": [
                            "0"
                          ]
                        }
                      ]
                    },
                    {
                      "op": "gt",
                      "args": [
                        "$delta1",
                        {
                          "op": "uint",
                          "args": [
                            "0"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "lt",
                      "args": [
                        "$delta0",
                        {
                          "op": "uint",
                          "args": [
                            "0"
                          ]
                        }
                      ]
                    },
                    {
                      "op": "lt",
                      "args": [
                        "$delta1",
                        {
                          "op": "uint",
                          "args": [
                            "0"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "error": "invalid signed swap deltas"
      },
      {
        "let": "isToken1",
        "value": {
          "op": "and",
          "args": [
            {
              "op": "gt",
              "args": [
                "$delta1",
                {
                  "op": "uint",
                  "args": [
                    "0"
                  ]
                }
              ]
            },
            {
              "op": "lt",
              "args": [
                "$delta0",
                {
                  "op": "uint",
                  "args": [
                    "0"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "let": "directed",
        "value": {
          "op": "or",
          "args": [
            "$isToken1",
            {
              "op": "and",
              "args": [
                {
                  "op": "gt",
                  "args": [
                    "$delta0",
                    {
                      "op": "uint",
                      "args": [
                        "0"
                      ]
                    }
                  ]
                },
                {
                  "op": "lt",
                  "args": [
                    "$delta1",
                    {
                      "op": "uint",
                      "args": [
                        "0"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "return": {
          "delta0": "$delta0",
          "delta1": "$delta1",
          "isToken1": "$isToken1",
          "directed": "$directed",
          "amountIn": {
            "op": "if",
            "args": [
              "$directed",
              {
                "op": "if",
                "args": [
                  "$isToken1",
                  "$delta1",
                  "$delta0"
                ]
              },
              {
                "op": "uint",
                "args": [
                  "0"
                ]
              }
            ]
          },
          "amountOut": {
            "op": "if",
            "args": [
              "$directed",
              {
                "op": "if",
                "args": [
                  "$isToken1",
                  {
                    "op": "sub",
                    "args": [
                      {
                        "op": "uint",
                        "args": [
                          "0"
                        ]
                      },
                      "$delta0"
                    ]
                  },
                  {
                    "op": "sub",
                    "args": [
                      {
                        "op": "uint",
                        "args": [
                          "0"
                        ]
                      },
                      "$delta1"
                    ]
                  }
                ]
              },
              {
                "op": "uint",
                "args": [
                  "0"
                ]
              }
            ]
          }
        }
      }
    ]
  },
