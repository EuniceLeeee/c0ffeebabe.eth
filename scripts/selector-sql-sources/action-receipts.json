    "deltas": [["tokens"],["-eth"]], "payer":"buyer", "recipient":"buyer"
  },
  {
    "actions": ["ethToTokenSwapInput(uint256,uint256)","ethToTokenTransferInput(uint256,uint256,address)"],
    "event": "TokenPurchase(address indexed buyer,uint256 indexed eth,uint256 indexed tokens)",
    "equals": {"buyer":"caller","eth":"value"},
    "assets": ["native","tokenAddress()"],
    "deltas": [["eth"],["-tokens"]], "payer":"buyer"
  }
]
