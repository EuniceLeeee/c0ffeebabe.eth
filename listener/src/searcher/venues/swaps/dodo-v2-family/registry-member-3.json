        "account": "$recipient",
        "equals": {
          "runtime": "sellOut"
        }
      },
      {
        "kind": "unchanged-token",
        "token": "$route.tokenOut",
        "account": "$executor",
        "when": "$externalRecipient"
      },
      {
        "kind": "unchanged-token",
        "token": "$route.tokenIn",
        "account": "$recipient",
        "when": "$externalRecipient"
      }
    ]
  }
}
