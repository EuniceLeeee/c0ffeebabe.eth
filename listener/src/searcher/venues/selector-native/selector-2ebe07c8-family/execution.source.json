{
  "format": "selector-execution-template/v1",
  "selector": "0x2ebe07c8",
  "signature": "function depositAsset(address, uint256, uint256, address)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_2EBE07C8_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": ["edge.tokenIn", "edge.tokenOut"],
    "watch": "pool-touch",
    "on": ["call-target", "log-emitter", "asset-transfer-endpoint"],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "deposit-asset",
    "resourceValues": {
      "inputs": ["sqlEdge"]
    },
    "projection": {
      "descriptor": {
        "tokenIn": { "op": "address", "args": ["$sqlEdge.tokenIn"] },
        "tokenOut": { "op": "address", "args": ["$sqlEdge.tokenOut"] }
      }
    },
    "routes": {
      "directions": [
        {
          "id": "deposit-asset",
          "enabled": true,
          "tokenIn": "$descriptor.tokenIn",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": { "slotKind": "protocol", "protocolAction": "wrap" }
        }
      ],
      "resource": { "target": "$descriptor.target" }
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": { "directOutput": false },
      "protectedAddresses": ["$target", "$route.tokenIn", "$route.tokenOut"],
      "contextChecks": [
        {
          "condition": { "op": "not", "args": ["$externalRecipient"] },
          "error": "eigenpie deposit mints to executor only"
        }
      ],
      "steps": [
        {
          "id": "deposit",
          "approval": {
            "token": "$route.tokenIn",
            "spender": "$target",
            "mode": "exact-clear",
            "requireBool": true,
            "verifyAllowance": true
          },
          "call": {
            "target": "$target",
            "signature": "function depositAsset(address, uint256, uint256, address)",
            "args": ["$route.tokenIn", { "runtime": "amountIn" }, "$minAmountOut", "0x0000000000000000000000000000000000000000"]
          }
        }
      ],
      "effects": [
        { "kind": "debit", "token": "$route.tokenIn", "account": "$executor", "equals": { "runtime": "amountIn" } },
        { "kind": "credit", "token": "$route.tokenOut", "account": "$recipient", "minimum": "$minAmountOut" },
        { "kind": "unchanged-native" }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
