{
  "format": "selector-family/v2",
  "selector": "0xdb006a75",
  "signature": "function redeem(uint256)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_DB006A75_ENABLED"
  },
  "programs": [
    {
      "binding": {
        "flow": {
          "version": 1,
          "steps": [
            {
              "id": "market",
              "requirements": {
                "transports": [
                  "eth-call"
                ]
              },
              "requests": [
                {
                  "id": "selectorBinding:market:underlying",
                  "kind": "eth-call",
                  "to": {
                    "op": "lower",
                    "args": [
                      {
                        "op": "address",
                        "args": [
                          "$target"
                        ]
                      }
                    ]
                  },
                  "data": {
                    "op": "encode",
                    "args": [
                      "bindingmarketunderlying",
                      "underlying()",
                      []
                    ]
                  },
                  "completion": "return-data"
                }
              ],
              "result": {
                "underlying": {
                  "op": "lower",
                  "args": [
                    {
                      "op": "address",
                      "args": [
                        {
                          "op": "decode",
                          "args": [
                            "bindingmarketunderlying",
                            "underlying()",
                            {
                              "op": "get",
                              "args": [
                                {
                                  "op": "returned",
                                  "args": [
                                    "selectorBinding:market:underlying"
                                  ]
                                },
                                "data"
                              ]
                            },
                            0
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "result": {
            "market": {
              "underlying": "$steps.market.underlying"
            }
          }
        },
        "descriptor": {
          "market": {
            "op": "address",
            "args": [
              "$target"
            ]
          },
          "underlying": {
            "op": "address",
            "args": [
              "$binding.market.underlying"
            ]
          },
          "share": {
            "op": "address",
            "args": [
              "$target"
            ]
          },
          "redemptionPathVerified": true
        }
      },
      "routes": {
        "target": {
          "op": "address",
          "args": [
            "$descriptor.market"
          ]
        },
        "directions": [
          {
            "id": "redeem",
            "enabled": "$descriptor.redemptionPathVerified",
            "tokenIn": {
              "op": "address",
              "args": [
                "$descriptor.share"
              ]
            },
            "tokenOut": {
              "op": "address",
              "args": [
                "$descriptor.underlying"
              ]
            },
            "taxonomy": {
              "slotKind": "protocol",
              "protocolAction": "redeem"
            }
          }
        ],
        "assertions": [
          {
            "assert": {
              "op": "not",
              "args": [
                {
                  "op": "sameAddress",
                  "args": [
                    "$descriptor.underlying",
                    "0x0000000000000000000000000000000000000000"
                  ]
                }
              ]
            },
            "error": "compound cToken underlying cannot be the zero address"
          },
          {
            "assert": {
              "op": "not",
              "args": [
                {
                  "op": "sameAddress",
                  "args": [
                    "$descriptor.share",
                    "$descriptor.underlying"
                  ]
                }
              ]
            },
            "error": "compound cToken share and underlying must be distinct"
          }
        ]
      },
      "execution": {
        "version": 2,
        "settlement": {
          "directOutput": false
        },
        "protectedAddresses": [
          "$descriptor.market",
          "$descriptor.underlying"
        ],
        "contextChecks": [
          {
            "condition": {
              "op": "not",
              "args": [
                "$externalRecipient"
              ]
            },
            "error": "compound cToken redeem pays the executor; an external recipient is unsupported"
          }
        ],
        "steps": [
          {
            "id": "redeem",
            "call": {
              "target": "$descriptor.market",
              "signature": "function redeem(uint256) returns (uint256)",
              "args": [
                {
                  "runtime": "amountIn"
                }
              ],
              "save": {
                "redeemCode": 0
              },
              "checks": [
                {
                  "left": {
                    "runtime": "redeemCode"
                  },
                  "operator": "eq",
                  "right": 0
                }
              ]
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "token": "$route.tokenIn",
            "account": "$executor",
            "equals": {
              "runtime": "amountIn"
            }
          },
          {
            "kind": "credit",
            "token": "$route.tokenOut",
            "account": "$recipient",
            "minimum": "$minAmountOut"
          },
          {
            "kind": "supply",
            "token": "$descriptor.market",
            "direction": "decrease",
            "equals": {
              "runtime": "amountIn"
            }
          }
        ]
      },
      "refreshPolicy": "each-block",
      "values": {
        "abi": {
          "bindingmarketunderlying": [
            "function underlying() view returns(address)"
          ]
        }
      },
      "meta": {
        "label": "protocol:compound-ctoken/comptroller-registered-ctoken"
      }
    },
    {
      "parameters": [
        {
          "path": [
            0
          ],
          "role": "amountIn"
        }
      ],
      "payment": {
        "kind": "none"
      },
      "values": {
        "abi": {
          "assettokenOut": [
            "function BTB_TOKEN() view returns(address)"
          ]
        }
      },
      "binding": {
        "flow": {
          "version": 1,
          "steps": [
            {
              "id": "assets",
              "requirements": {
                "transports": [
                  "eth-call"
                ]
              },
              "requests": {
                "op": "concat",
                "args": [
                  {
                    "op": "if",
                    "args": [
                      {
                        "op": "not",
                        "args": [
                          {
                            "op": "defined",
                            "args": [
                              "$scope.tokenOut"
                            ]
                          }
                        ]
                      },
                      [
                        {
                          "id": "selector-assets:tokenOut",
                          "kind": "eth-call",
                          "to": "$target",
                          "data": {
                            "op": "encode",
                            "args": [
                              "assettokenOut",
                              "BTB_TOKEN()",
                              []
                            ]
                          },
                          "completion": "return-data"
                        }
                      ],
                      []
                    ]
                  }
                ]
              },
              "result": {
                "tokenIn": {
                  "op": "coalesce",
                  "args": [
                    "$scope.tokenIn",
                    "$target"
                  ]
                },
                "tokenOut": {
                  "op": "coalesce",
                  "args": [
                    "$scope.tokenOut",
                    {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            {
                              "op": "decode",
                              "args": [
                                "assettokenOut",
                                "BTB_TOKEN()",
                                {
                                  "op": "get",
                                  "args": [
                                    {
                                      "op": "returned",
                                      "args": [
                                        "selector-assets:tokenOut"
                                      ]
                                    },
                                    "data"
                                  ]
                                },
                                0
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "result": {
            "tokenIn": "$steps.assets.tokenIn",
            "tokenOut": "$steps.assets.tokenOut"
          }
        },
        "descriptor": {
          "tokenIn": "$binding.tokenIn",
          "tokenOut": "$binding.tokenOut"
        }
      },
      "meta": {
        "label": "protocol:token-conversion/btb-bear-v1"
      },
      "routes": {
        "directions": [
          {
            "id": "redeem",
            "enabled": true,
            "tokenIn": "$descriptor.tokenIn",
            "tokenOut": "$descriptor.tokenOut",
            "taxonomy": {
              "slotKind": "protocol",
              "protocolAction": "redeem"
            }
          }
        ]
      },
      "refreshPolicy": "each-block"
    }
  ]
}
