{
  "format": "selector-execution-template/v1",
  "selector": "0xdb006a75",
  "signature": "function redeem(uint256)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_DB006A75_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": ["edge.tokenIn", "edge.tokenOut"],
    "watch": "pool-touch",
    "on": ["call-target", "log-emitter", "asset-transfer-endpoint"],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "redeem",
    "resourceValues": {
      "inputs": ["sqlEdge"]
    },
    "projection": {
      "descriptor": {
        "tokenIn": { "op": "address", "args": ["$sqlEdge.tokenIn"] },
        "tokenOut": { "op": "address", "args": ["$sqlEdge.tokenOut"] }
      }
    },
    "routes": {
      "directions": [
        {
          "id": "redeem",
          "enabled": true,
          "tokenIn": "$descriptor.tokenIn",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": { "slotKind": "protocol", "protocolAction": "redeem" }
        }
      ],
      "resource": { "target": "$descriptor.target" }
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": { "directOutput": false },
      "protectedAddresses": ["$target", "$route.tokenOut"],
      "contextChecks": [
        {
          "condition": { "op": "not", "args": ["$externalRecipient"] },
          "error": "compound cToken redeem pays executor only"
        }
      ],
      "steps": [
        {
          "id": "redeem",
          "call": {
            "target": "$target",
            "signature": "function redeem(uint256) returns (uint256)",
            "args": [{ "runtime": "amountIn" }],
            "save": { "redeemCode": 0 },
            "checks": [{ "left": { "runtime": "redeemCode" }, "operator": "eq", "right": 0 }]
          }
        }
      ],
      "effects": [
        { "kind": "debit", "token": "$route.tokenIn", "account": "$executor", "equals": { "runtime": "amountIn" } },
        { "kind": "credit", "token": "$route.tokenOut", "account": "$recipient", "minimum": "$minAmountOut" },
        { "kind": "unchanged-native" }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
