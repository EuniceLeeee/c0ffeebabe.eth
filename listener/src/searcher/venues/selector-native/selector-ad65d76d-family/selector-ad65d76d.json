{
  "format": "selector-family/v2",
  "selector": "0xad65d76d",
  "signature": "function ethToTokenTransferInput(uint256, uint256, address)",
  "domain": "swap",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_AD65D76D_ENABLED"
  },
  "directState": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block",
    "discoveryRuleHash": "624034c54dbd191e82f00897d47e750aad8ccf18bbf5142a68bb0fafa0ec7597"
  },
  "programs": [
    {
      "type": "independentIdentity",
      "values": {
        "abi": {
          "endpointRead0": [
            "function tokenAddress() view returns (address)"
          ]
        }
      },
      "binding": {
        "flow": {
          "version": 1,
          "steps": [
            {
              "id": "identity",
              "requirements": {
                "transports": [
                  "eth-call"
                ]
              },
              "requests": [
                {
                  "id": "identity:ep0",
                  "kind": "eth-call",
                  "to": "$target",
                  "data": {
                    "op": "encode",
                    "args": [
                      "endpointRead0",
                      "tokenAddress()",
                      []
                    ]
                  },
                  "completion": "return-data"
                }
              ],
              "decode": [
                {
                  "let": "r",
                  "value": {
                    "ep0": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            {
                              "op": "decodeCanonical",
                              "args": [
                                "endpointRead0",
                                "tokenAddress()",
                                {
                                  "op": "get",
                                  "args": [
                                    {
                                      "op": "returned",
                                      "args": [
                                        "identity:ep0"
                                      ]
                                    },
                                    "data"
                                  ]
                                },
                                0
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "return": {
                    "direction": "buy",
                    "tokenIn": "0x0000000000000000000000000000000000000000",
                    "tokenOut": "$r.ep0"
                  }
                }
              ]
            }
          ],
          "result": "$steps.identity"
        },
        "descriptor": {
          "direction": "buy",
          "tokenIn": {
            "op": "address",
            "args": [
              "$binding.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$binding.tokenOut"
            ]
          },
          "allowNativeToken": true
        }
      },
      "checks": [
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenIn",
              "$scope.tokenIn"
            ]
          },
          "error": "identity input differs from edge"
        },
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenOut",
              "$scope.tokenOut"
            ]
          },
          "error": "identity output differs from edge"
        }
      ]
    },
    {
      "type": "execution",
      "resourceValues": {
        "inputs": [
          "sqlEdge"
        ]
      },
      "routes": {
        "target": "$descriptor.pool",
        "directions": [
          {
            "id": "buy",
            "enabled": true,
            "tokenIn": "$descriptor.tokenIn",
            "tokenOut": "$descriptor.tokenOut",
            "taxonomy": {
              "slotKind": "swap"
            },
            "executionAssets": {
              "input": "native",
              "output": "erc20"
            },
            "fields": {
              "pool": "$descriptor.pool"
            }
          }
        ],
        "venue": {
          "kind": "address-pool",
          "pool": {
            "op": "lower",
            "args": [
              {
                "op": "address",
                "args": [
                  "$descriptor.pool"
                ]
              }
            ]
          }
        }
      },
      "execution": {
        "version": 2,
        "requireCanonicalSource": true,
        "settlement": {
          "directOutput": true
        },
        "protectedAddresses": [
          "$target",
          "$route.tokenIn",
          "$route.tokenOut"
        ],
        "steps": [
          {
            "id": "buySwap",
            "call": {
              "target": "$target",
              "signature": "function ethToTokenTransferInput(uint256, uint256, address) payable returns (uint256)",
              "args": [
                1,
                "115792089237316195423570985008687907853269984665640564039457584007913129639935",
                "$recipient"
              ],
              "value": {
                "runtime": "amountIn"
              },
              "save": {
                "boughtTokens": 0
              }
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "asset": "native",
            "account": "$executor",
            "equals": {
              "runtime": "amountIn"
            }
          },
          {
            "kind": "credit",
            "token": "$route.tokenOut",
            "account": "$recipient",
            "equals": {
              "runtime": "boughtTokens"
            },
            "minimum": "$minAmountOut"
          }
        ]
      },
      "refreshPolicy": "on-touch",
      "sourceRefreshPolicy": "on-touch",
      "projection": {
        "descriptor": {
          "pool": "$target",
          "tokenIn": "0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2",
          "tokenOut": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenOut"
            ]
          }
        }
      }
    }
  ]
}
