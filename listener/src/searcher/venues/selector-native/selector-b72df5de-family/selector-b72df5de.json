      "runtimeMath": {
        "version": 1,
        "entries": {
          "depositAmounts": {
            "model": "curve:deposit-2coin-amounts",
            "version": 1
          }
        },
        "models": [
          {
            "id": "curve:deposit-2coin-amounts",
            "version": 1,
            "inputs": [
              "amountIn",
              "coin1",
              "tokenIn"
            ],
            "outputs": [
              "amt0",
              "amt1"
            ],
            "operations": [
              {
                "name": "isCoin1",
                "op": "eq",
                "left": {
                  "input": "coin1"
                },
                "right": {
                  "input": "tokenIn"
                }
              },
              {
                "name": "isCoin0",
                "op": "sub",
                "left": {
                  "constant": "1"
                },
                "right": {
                  "local": "isCoin1"
                }
              },
              {
                "name": "amt0",
                "op": "mul",
                "left": {
                  "input": "amountIn"
                },
                "right": {
                  "local": "isCoin0"
                }
              },
              {
                "name": "amt1",
                "op": "mul",
                "left": {
                  "input": "amountIn"
                },
                "right": {
                  "local": "isCoin1"
                }
              }
            ]
          }
        ]
