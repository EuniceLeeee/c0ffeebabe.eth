              "requireBool": true,
              "verifyAllowance": true
            },
            "call": {
              "target": "$target",
              "signature": "function add_liquidity(uint256[], uint256)",
              "args": [
                [
                  {
                    "runtime": "amt0"
                  },
                  {
                    "runtime": "amt1"
                  }
                ],
                "$minAmountOut"
              ]
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "token": "$route.tokenIn",
            "account": "$executor",
            "equals": {
              "runtime": "amountIn"
