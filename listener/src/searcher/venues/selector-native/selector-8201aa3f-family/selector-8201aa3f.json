{
  "format": "selector-family/v2",
  "selector": "0x8201aa3f",
  "signature": "function swapExactAmountIn(address, uint256, address, uint256, uint256)",
  "domain": "swap",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_8201AA3F_ENABLED"
  },
  "directState": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block",
    "discoveryRuleHash": "1cdaf8642620d2b7d70214faf049d7168e93f72721b13b63ad04986798bc8cd8"
  },
  "programs": [
    {
      "type": "independentIdentity",
      "values": {
        "abi": {
          "tokenListRead": [
            "function getFinalTokens() view returns (address[])"
          ]
        }
      },
      "binding": {
        "flow": {
          "version": 1,
          "steps": [
            {
              "id": "identity",
              "requirements": {
                "transports": [
                  "eth-call"
                ]
              },
              "requests": [
                {
                  "id": "identity:tokenList",
                  "kind": "eth-call",
                  "to": "$target",
                  "data": {
                    "op": "encode",
                    "args": [
                      "tokenListRead",
                      "getFinalTokens()",
                      []
                    ]
                  },
                  "completion": "return-data"
                }
              ],
              "decode": [
                {
                  "let": "rawTokens",
                  "value": {
                    "op": "decodeCanonical",
                    "args": [
                      "tokenListRead",
                      "getFinalTokens()",
                      {
                        "op": "get",
                        "args": [
                          {
                            "op": "returned",
                            "args": [
                              "identity:tokenList"
                            ]
                          },
                          "data"
                        ]
                      },
                      0
                    ]
                  }
                },
                {
                  "let": "tokens",
                  "value": {
                    "op": "map",
                    "args": [
                      "$rawTokens",
                      "tok",
                      {
                        "op": "lower",
                        "args": [
                          {
                            "op": "address",
                            "args": [
                              "$tok"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "assert": {
                    "op": "some",
                    "args": [
                      "$tokens",
                      "tok",
                      {
                        "op": "sameAddress",
                        "args": [
                          "$tok",
                          "$scope.tokenIn"
                        ]
                      }
                    ]
                  },
                  "error": "tokenIn not in pool tokenList"
                },
                {
                  "assert": {
                    "op": "some",
                    "args": [
                      "$tokens",
                      "tok",
                      {
                        "op": "sameAddress",
                        "args": [
                          "$tok",
                          "$scope.tokenOut"
                        ]
                      }
                    ]
                  },
                  "error": "tokenOut not in pool tokenList"
                },
                {
                  "return": {
                    "direction": "bpool-swap",
                    "tokenIn": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            "$scope.tokenIn"
                          ]
                        }
                      ]
                    },
                    "tokenOut": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            "$scope.tokenOut"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "result": "$steps.identity"
        },
        "descriptor": {
          "direction": "bpool-swap",
          "tokenIn": {
            "op": "address",
            "args": [
              "$binding.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$binding.tokenOut"
            ]
          }
        }
      },
      "checks": [
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenIn",
              "$scope.tokenIn"
            ]
          },
          "error": "identity input differs from edge"
        },
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenOut",
              "$scope.tokenOut"
            ]
          },
          "error": "identity output differs from edge"
        }
      ]
    },
    {
      "type": "execution",
      "resourceValues": {
        "inputs": [
          "sqlEdge"
        ]
      },
      "routes": {
        "target": "$descriptor.pool",
        "directions": [
          {
            "id": "swap",
            "enabled": true,
            "tokenIn": "$descriptor.tokenIn",
            "tokenOut": "$descriptor.tokenOut",
            "taxonomy": {
              "slotKind": "swap"
            },
            "fields": {
              "pool": "$descriptor.pool"
            }
          }
        ],
        "venue": {
          "kind": "address-pool",
          "pool": {
            "op": "lower",
            "args": [
              {
                "op": "address",
                "args": [
                  "$descriptor.pool"
                ]
              }
            ]
          }
        }
      },
      "execution": {
        "version": 2,
        "requireCanonicalSource": true,
        "settlement": {
          "directOutput": false
        },
        "protectedAddresses": [
          "$target",
          "$route.tokenIn",
          "$route.tokenOut"
        ],
        "contextChecks": [
          {
            "condition": {
              "op": "not",
              "args": [
                "$externalRecipient"
              ]
            },
            "error": "balancer v1 swapExactAmountIn pays caller only"
          }
        ],
        "steps": [
          {
            "id": "swap",
            "approval": {
              "token": "$route.tokenIn",
              "spender": "$target",
              "mode": "exact-clear",
              "requireBool": true,
              "verifyAllowance": true
            },
            "call": {
              "target": "$target",
              "signature": "function swapExactAmountIn(address, uint256, address, uint256, uint256)",
              "args": [
                "$route.tokenIn",
                {
                  "runtime": "amountIn"
                },
                "$route.tokenOut",
                "$minAmountOut",
                "115792089237316195423570985008687907853269984665640564039457584007913129639935"
              ]
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "token": "$route.tokenIn",
            "account": "$executor",
            "equals": {
              "runtime": "amountIn"
            }
          },
          {
            "kind": "credit",
            "token": "$route.tokenOut",
            "account": "$recipient",
            "minimum": "$minAmountOut"
          },
          {
            "kind": "unchanged-native"
          }
        ]
      },
      "refreshPolicy": "on-touch",
      "sourceRefreshPolicy": "on-touch",
      "projection": {
        "descriptor": {
          "pool": "$target",
          "tokenIn": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenOut"
            ]
          }
        }
      }
    }
  ]
}
