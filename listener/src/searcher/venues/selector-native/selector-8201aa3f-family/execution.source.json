{
  "format": "selector-execution-template/v1",
  "selector": "0x8201aa3f",
  "signature": "function swapExactAmountIn(address, uint256, address, uint256, uint256)",
  "domain": "swap",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_8201AA3F_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "balancer-v1-swap-exact-in",
    "resourceValues": {
      "inputs": [
        "sqlEdge"
      ]
    },
    "projection": {
      "descriptor": {
        "pool": "$target",
        "tokenIn": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenIn"
          ]
        },
        "tokenOut": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenOut"
          ]
        }
      }
    },
    "routes": {
      "target": "$descriptor.pool",
      "directions": [
        {
          "id": "swap",
          "enabled": true,
          "tokenIn": "$descriptor.tokenIn",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": {
            "slotKind": "swap"
          },
          "fields": {
            "pool": "$descriptor.pool"
          }
        }
      ],
      "venue": {
        "kind": "address-pool",
        "pool": {
          "op": "lower",
          "args": [
            {
              "op": "address",
              "args": [
                "$descriptor.pool"
              ]
            }
          ]
        }
      }
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": {
        "directOutput": false
      },
      "protectedAddresses": [
        "$target",
        "$route.tokenIn",
        "$route.tokenOut"
      ],
      "contextChecks": [
        {
          "condition": {
            "op": "not",
            "args": [
              "$externalRecipient"
            ]
          },
          "error": "balancer v1 swapExactAmountIn pays caller only"
        }
      ],
      "steps": [
        {
          "id": "swap",
          "approval": {
            "token": "$route.tokenIn",
            "spender": "$target",
            "mode": "exact-clear",
            "requireBool": true,
            "verifyAllowance": true
          },
          "call": {
            "target": "$target",
            "signature": "function swapExactAmountIn(address, uint256, address, uint256, uint256)",
            "args": [
              "$route.tokenIn",
              {
                "runtime": "amountIn"
              },
              "$route.tokenOut",
              "$minAmountOut",
              "115792089237316195423570985008687907853269984665640564039457584007913129639935"
            ]
          }
        }
      ],
      "effects": [
        {
          "kind": "debit",
          "token": "$route.tokenIn",
          "account": "$executor",
          "equals": {
            "runtime": "amountIn"
          }
        },
        {
          "kind": "credit",
          "token": "$route.tokenOut",
          "account": "$recipient",
          "minimum": "$minAmountOut"
        },
        {
          "kind": "unchanged-native"
        }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
