    "discoveryRuleHash": "cb17745e8e57678a3285d9bf141b76688f6fd2fc63b9c1c4edab63117a3467d9"
  },
  "programs": [
    {
      "type": "independentIdentity",
      "values": {
        "abi": {
          "daiRead": [
            "function dai() view returns (address)"
