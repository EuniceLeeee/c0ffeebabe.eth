        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenOut",
              "$scope.tokenOut"
            ]
          },
          "error": "identity output differs from edge"
        }
      ]
    },
    {
      "type": "execution",
      "resourceValues": {
        "inputs": [
          "sqlEdge"
        ]
      },
      "routes": {
        "directions": [
          {
            "id": "buy-gem",
            "enabled": true,
            "tokenIn": "$descriptor.tokenIn",
            "tokenOut": "$descriptor.tokenOut",
            "taxonomy": {
              "slotKind": "protocol",
              "protocolAction": "convert"
            }
          }
        ],
        "resource": {
          "target": "$descriptor.target"
        }
      },
      "execution": {
        "version": 2,
        "requireCanonicalSource": true,
        "settlement": {
          "directOutput": true
        },
        "protectedAddresses": [
          "$target",
          "$route.tokenIn",
          "$route.tokenOut"
        ],
        "steps": [
          {
            "id": "fee",
            "static": true,
            "call": {
              "target": "$target",
              "signature": "function tout() view returns (uint256)",
              "args": [],
              "save": {
                "psmFee": 0
              }
            }
          },
          {
            "id": "scale",
            "static": true,
            "call": {
              "target": "$target",
              "signature": "function to18ConversionFactor() view returns (uint256)",
              "args": [],
              "save": {
                "psmScale": 0
              },
              "checks": [
                {
                  "left": {
                    "runtime": "psmScale"
                  },
                  "operator": "gte",
                  "right": 1
                }
              ]
            }
          },
          {
            "id": "terms",
            "math": {
              "model": "psmTerms",
              "inputs": {
                "amountIn": {
                  "runtime": "amountIn"
                },
                "fee": {
                  "runtime": "psmFee"
                },
                "scale": {
                  "runtime": "psmScale"
                },
                "isBuy": {
                  "op": "uint",
                  "args": [
                    "1"
                  ]
                }
              },
              "outputs": {
                "callAmount": "psmCallAmount",
                "expectedOut": "psmExpectedOut",
                "expectedSpend": "psmExpectedSpend",
                "expectedReturn": "psmExpectedReturn"
              },
              "checks": [
                {
                  "left": "1000000000000000000",
                  "operator": "gte",
                  "right": {
                    "runtime": "psmFee"
                  }
                },
                {
                  "left": {
                    "runtime": "amountIn"
                  },
                  "operator": "gte",
                  "right": {
                    "runtime": "psmExpectedSpend"
                  }
                },
                {
                  "left": {
                    "runtime": "psmCallAmount"
                  },
                  "operator": "gte",
                  "right": 1
                },
                {
                  "left": {
                    "runtime": "psmExpectedOut"
                  },
                  "operator": "gte",
                  "right": 1
                }
              ]
            }
          },
          {
            "id": "swap",
            "approval": {
              "token": "$route.tokenIn",
              "spender": "$target",
              "mode": "exact-clear",
              "amount": {
                "runtime": "psmExpectedSpend"
              },
              "requireBool": true
            },
            "call": {
              "target": "$target",
              "signature": "function buyGem(address, uint256)",
              "args": [
                "$recipient",
                {
                  "runtime": "psmCallAmount"
                }
              ]
            },
            "effects": [
              {
                "kind": "debit",
                "token": "$route.tokenIn",
                "account": "$executor",
                "equals": {
                  "runtime": "psmExpectedSpend"
                }
              },
              {
                "kind": "credit",
                "token": "$route.tokenOut",
                "account": "$recipient",
                "equals": {
                  "runtime": "psmExpectedOut"
                }
              }
            ]
          },
          {
            "id": "allowance",
            "static": true,
            "call": {
              "target": "$route.tokenIn",
              "signature": "function allowance(address,address) view returns (uint256)",
              "args": [
                "$executor",
                "$target"
              ],
              "save": {
                "psmAllowance": 0
              },
              "checks": [
                {
                  "left": {
                    "runtime": "psmAllowance"
                  },
                  "operator": "eq",
                  "right": 0
                }
              ]
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "token": "$route.tokenIn",
            "account": "$executor",
            "maximum": {
              "runtime": "amountIn"
            }
          },
          {
            "kind": "credit",
            "token": "$route.tokenOut",
            "account": "$recipient",
            "minimum": "$minAmountOut"
          },
          {
            "kind": "unchanged-token",
            "token": "$route.tokenOut",
            "account": "$executor",
            "when": "$externalRecipient"
          },
          {
            "kind": "unchanged-token",
            "token": "$route.tokenIn",
            "account": "$recipient",
            "when": "$externalRecipient"
          },
          {
            "kind": "unchanged-native"
          }
        ]
      },
      "runtimeMath": {
        "version": 1,
        "entries": {
          "psmTerms": {
            "model": "psm:runtime-terms",
            "version": 1
          }
        },
        "models": [
          {
            "id": "psm:runtime-terms",
            "version": 1,
            "inputs": [
              "amountIn",
              "fee",
              "scale",
              "isBuy"
            ],
            "outputs": [
              "callAmount",
              "expectedOut",
              "expectedSpend",
              "expectedReturn"
            ],
            "operations": [
              {
                "name": "isSell",
                "op": "sub",
                "left": {
                  "constant": "1"
                },
                "right": {
                  "input": "isBuy"
                }
              },
              {
                "name": "sellAmount",
                "op": "mul",
                "left": {
                  "input": "amountIn"
                },
                "right": {
                  "local": "isSell"
                }
              },
              {
                "name": "sellScaled",
                "op": "mul",
                "left": {
                  "local": "sellAmount"
                },
                "right": {
                  "input": "scale"
                }
              },
              {
                "name": "sellFeeScaled",
                "op": "mul",
                "left": {
                  "local": "sellScaled"
                },
                "right": {
                  "input": "fee"
                }
              },
              {
                "name": "sellFee",
                "op": "div",
                "left": {
                  "local": "sellFeeScaled"
                },
                "right": {
                  "constant": "1000000000000000000"
                }
              },
              {
                "name": "sellOut",
                "op": "sub",
                "left": {
                  "local": "sellScaled"
                },
                "right": {
                  "local": "sellFee"
                }
              },
              {
                "name": "buyBudget",
                "op": "mul",
                "left": {
                  "input": "amountIn"
                },
                "right": {
                  "input": "isBuy"
                }
              },
              {
                "name": "buyNext",
                "op": "add",
                "left": {
                  "local": "buyBudget"
                },
                "right": {
                  "constant": "1"
                }
              },
              {
                "name": "buyWide",
                "op": "mul",
                "left": {
                  "local": "buyNext"
                },
                "right": {
                  "constant": "1000000000000000000"
                }
              },
              {
                "name": "buyNumerator",
                "op": "sub",
                "left": {
                  "local": "buyWide"
                },
                "right": {
                  "constant": "1"
                }
              },
              {
                "name": "buyDenominator",
                "op": "add",
                "left": {
                  "constant": "1000000000000000000"
                },
                "right": {
                  "input": "fee"
                }
              },
              {
                "name": "buyGemWide",
                "op": "div",
                "left": {
                  "local": "buyNumerator"
                },
                "right": {
                  "local": "buyDenominator"
                }
              },
              {
                "name": "buyGem",
                "op": "div",
                "left": {
                  "local": "buyGemWide"
                },
                "right": {
                  "input": "scale"
                }
              },
              {
                "name": "buyScaled",
                "op": "mul",
                "left": {
                  "local": "buyGem"
                },
                "right": {
                  "input": "scale"
                }
              },
              {
                "name": "buyFeeScaled",
                "op": "mul",
                "left": {
                  "local": "buyScaled"
                },
                "right": {
                  "input": "fee"
                }
              },
              {
                "name": "buyFee",
                "op": "div",
                "left": {
                  "local": "buyFeeScaled"
                },
                "right": {
                  "constant": "1000000000000000000"
                }
              },
              {
                "name": "buyCost",
                "op": "add",
                "left": {
                  "local": "buyScaled"
                },
                "right": {
                  "local": "buyFee"
                }
              },
              {
                "name": "callAmount",
                "op": "add",
                "left": {
                  "local": "sellAmount"
                },
                "right": {
                  "local": "buyGem"
                }
              },
              {
                "name": "expectedOut",
                "op": "add",
                "left": {
                  "local": "sellOut"
                },
                "right": {
                  "local": "buyGem"
                }
              },
              {
                "name": "expectedSpend",
                "op": "add",
                "left": {
                  "local": "sellAmount"
                },
                "right": {
                  "local": "buyCost"
                }
              },
              {
                "name": "expectedReturn",
                "op": "add",
                "left": {
                  "local": "sellOut"
                },
                "right": {
                  "local": "buyCost"
                }
              }
            ]
          }
        ]
      },
      "refreshPolicy": "on-touch",
      "sourceRefreshPolicy": "on-touch",
      "projection": {
        "descriptor": {
          "tokenIn": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenIn"
            ]
