{
  "format": "selector-family/v2",
  "selector": "0x8d7ef9bb",
  "signature": "function buyGem(address, uint256)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_8D7EF9BB_ENABLED"
