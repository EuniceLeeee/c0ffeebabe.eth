{
  "format": "selector-execution-template/v1",
  "selector": "0xfea53be1",
  "signature": "function redeem(address, uint256, address, address)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_FEA53BE1_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "silo-redeem",
    "resourceValues": {
      "inputs": [
        "sqlEdge"
      ]
    },
    "projection": {
      "descriptor": {
        "tokenIn": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenIn"
          ]
        },
        "tokenOut": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenOut"
          ]
        }
      }
    },
    "routes": {
      "directions": [
        {
          "id": "silo-redeem",
          "enabled": true,
          "tokenIn": "$descriptor.tokenIn",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": {
            "slotKind": "protocol",
            "protocolAction": "redeem"
          }
        }
      ],
      "resource": {
        "target": "$descriptor.target"
      }
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": {
        "directOutput": true
      },
      "protectedAddresses": [
        "$target",
        "$route.tokenOut"
      ],
      "steps": [
        {
          "id": "redeem",
          "call": {
            "target": "$target",
            "signature": "function redeem(address, uint256, address, address) returns (uint256)",
            "args": [
              "$route.tokenOut",
              {
                "runtime": "amountIn"
              },
              "$recipient",
              "$executor"
            ],
            "save": {
              "output": 0
            },
            "checks": [
              {
                "left": {
                  "runtime": "output"
                },
                "operator": "gte",
                "right": 1
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "kind": "debit",
          "token": "$route.tokenIn",
          "account": "$executor",
          "equals": {
            "runtime": "amountIn"
          }
        },
        {
          "kind": "credit",
          "token": "$route.tokenOut",
          "account": "$recipient",
          "equals": {
            "runtime": "output"
          },
          "minimum": "$minAmountOut"
        },
        {
          "kind": "unchanged-token",
          "token": "$route.tokenIn",
          "account": "$recipient",
          "when": "$externalRecipient"
        },
        {
          "kind": "unchanged-token",
          "token": "$route.tokenOut",
          "account": "$executor",
          "when": "$externalRecipient"
        },
        {
          "kind": "unchanged-native"
        }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
