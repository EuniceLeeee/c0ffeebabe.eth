{
  "format": "selector-family/v2",
  "selector": "0xfea53be1",
  "signature": "function redeem(address, uint256, address, address)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_FEA53BE1_ENABLED"
  },
  "directState": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block",
    "discoveryRuleHash": "08d4d2b1b2c7928dd7249ebe18ee481b5679564c5bc6ecf5e59a78acae1806f8"
  },
  "programs": [
    {
      "type": "independentIdentity",
      "values": {
        "abi": {
          "endpointRead0": [
            "function previewRedeem(uint256) view returns (uint256)"
          ]
        }
      },
      "binding": {
        "flow": {
          "version": 1,
          "steps": [
            {
              "id": "identity",
              "requirements": {
                "transports": [
                  "eth-call"
                ]
              },
              "requests": [
                {
                  "id": "identity:ep0",
                  "kind": "eth-call",
                  "to": "$target",
                  "data": {
                    "op": "encode",
                    "args": [
                      "endpointRead0",
                      "previewRedeem(uint256)",
                      [
                        1000000
                      ]
                    ]
                  },
                  "completion": "return-data"
                }
              ],
              "decode": [
                {
                  "let": "r",
                  "value": {
                    "ep0": {
                      "op": "decodeCanonical",
                      "args": [
                        "endpointRead0",
                        "previewRedeem(uint256)",
                        {
                          "op": "get",
                          "args": [
                            {
                              "op": "returned",
                              "args": [
                                "identity:ep0"
                              ]
                            },
                            "data"
                          ]
                        },
                        0
                      ]
                    }
                  }
                },
                {
                  "assert": {
                    "op": "gte",
                    "args": [
                      "$r.ep0",
                      {
                        "op": "uint",
                        "args": [
                          "1"
                        ]
                      }
                    ]
                  },
                  "error": "identity min check failed: previewRedeem"
                },
                {
                  "return": {
                    "direction": "silo-redeem",
                    "tokenIn": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            "$target"
                          ]
                        }
                      ]
                    },
                    "tokenOut": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            "$scope.tokenOut"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "result": "$steps.identity"
        },
        "descriptor": {
          "direction": "silo-redeem",
          "tokenIn": {
            "op": "address",
            "args": [
              "$binding.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$binding.tokenOut"
            ]
          }
        }
      },
      "checks": [
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenIn",
              "$scope.tokenIn"
            ]
          },
          "error": "identity input differs from edge"
        },
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenOut",
              "$scope.tokenOut"
            ]
          },
          "error": "identity output differs from edge"
        }
      ]
    },
    {
      "type": "execution",
      "resourceValues": {
        "inputs": [
          "sqlEdge"
        ]
      },
      "routes": {
        "directions": [
          {
            "id": "silo-redeem",
            "enabled": true,
            "tokenIn": "$descriptor.tokenIn",
            "tokenOut": "$descriptor.tokenOut",
            "taxonomy": {
              "slotKind": "protocol",
              "protocolAction": "redeem"
            }
          }
        ],
        "resource": {
          "target": "$descriptor.target"
        }
      },
      "execution": {
        "version": 2,
        "requireCanonicalSource": true,
        "settlement": {
          "directOutput": true
        },
        "protectedAddresses": [
          "$target",
          "$route.tokenOut"
        ],
        "steps": [
          {
            "id": "redeem",
            "call": {
              "target": "$target",
              "signature": "function redeem(address, uint256, address, address) returns (uint256)",
              "args": [
                "$route.tokenOut",
                {
                  "runtime": "amountIn"
                },
                "$recipient",
                "$executor"
              ],
              "save": {
                "output": 0
              },
              "checks": [
                {
                  "left": {
                    "runtime": "output"
                  },
                  "operator": "gte",
                  "right": 1
                }
              ]
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "token": "$route.tokenIn",
            "account": "$executor",
            "equals": {
              "runtime": "amountIn"
            }
          },
          {
            "kind": "credit",
            "token": "$route.tokenOut",
            "account": "$recipient",
            "equals": {
              "runtime": "output"
            },
            "minimum": "$minAmountOut"
          },
          {
            "kind": "unchanged-token",
            "token": "$route.tokenIn",
            "account": "$recipient",
            "when": "$externalRecipient"
          },
          {
            "kind": "unchanged-token",
            "token": "$route.tokenOut",
            "account": "$executor",
            "when": "$externalRecipient"
          },
          {
            "kind": "unchanged-native"
          }
        ]
      },
      "refreshPolicy": "on-touch",
      "sourceRefreshPolicy": "on-touch",
      "projection": {
        "descriptor": {
          "tokenIn": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenOut"
            ]
          }
        }
      }
    }
  ]
}
