{
  "format": "selector-execution-template/v1",
  "selector": "0xe2ad025a",
  "signature": "function exchange_underlying(uint256, uint256, uint256, uint256, address)",
  "domain": "swap",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_E2AD025A_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "curve-exchange-underlying",
    "resourceValues": {
      "inputs": [
        "sqlEdge"
      ]
    },
    "projection": {
      "descriptor": {
        "pool": "$target",
        "tokenIn": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenIn"
          ]
        },
        "tokenOut": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenOut"
          ]
        }
      }
    },
    "routes": {
      "target": "$descriptor.pool",
      "directions": [
        {
          "id": "swap",
          "enabled": true,
          "tokenIn": "$descriptor.tokenIn",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": {
            "slotKind": "swap"
          },
          "fields": {
            "pool": "$descriptor.pool"
          }
        }
      ],
      "venue": {
        "kind": "address-pool",
        "pool": {
          "op": "lower",
          "args": [
            {
              "op": "address",
              "args": [
                "$descriptor.pool"
              ]
            }
          ]
        }
      }
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": {
        "directOutput": true
      },
      "protectedAddresses": [
        "$target",
        "$route.tokenIn",
        "$route.tokenOut"
      ],
      "steps": [
        {
          "id": "coin0",
          "static": true,
          "call": {
            "target": "$target",
            "signature": "function coins(uint256) view returns (address)",
            "args": [
              0
            ],
            "save": {
              "coin0": 0
            }
          }
        },
        {
          "id": "coin1",
          "static": true,
          "call": {
            "target": "$target",
            "signature": "function coins(uint256) view returns (address)",
            "args": [
              1
            ],
            "save": {
              "coin1": 0
            }
          }
        },
        {
          "id": "indices",
          "math": {
            "model": "coinIndices",
            "inputs": {
              "coin0": {
                "runtime": "coin0"
              },
              "coin1": {
                "runtime": "coin1"
              },
              "tokenIn": {
                "op": "uint",
                "args": [
                  "$route.tokenIn"
                ]
              },
              "tokenOut": {
                "op": "uint",
                "args": [
                  "$route.tokenOut"
                ]
              }
            },
            "outputs": {
              "indexIn": "indexIn",
              "indexOut": "indexOut"
            }
          }
        },
        {
          "id": "exchangeUnderlying",
          "approval": {
            "token": "$route.tokenIn",
            "spender": "$target",
            "mode": "exact-clear",
            "requireBool": true,
            "verifyAllowance": true
          },
          "call": {
            "target": "$target",
            "signature": "function exchange_underlying(uint256, uint256, uint256, uint256, address)",
            "args": [
              {
                "runtime": "indexIn"
              },
              {
                "runtime": "indexOut"
              },
              {
                "runtime": "amountIn"
              },
              "$minAmountOut",
              "$recipient"
            ]
          }
        }
      ],
      "effects": [
        {
          "kind": "debit",
          "token": "$route.tokenIn",
          "account": "$executor",
          "equals": {
            "runtime": "amountIn"
          }
        },
        {
          "kind": "credit",
          "token": "$route.tokenOut",
          "account": "$recipient",
          "minimum": "$minAmountOut"
        },
        {
          "kind": "unchanged-token",
          "token": "$route.tokenIn",
          "account": "$recipient",
          "when": "$externalRecipient"
        },
        {
          "kind": "unchanged-token",
          "token": "$route.tokenOut",
          "account": "$executor",
          "when": "$externalRecipient"
        },
        {
          "kind": "unchanged-native"
        }
      ]
    },
    "runtimeMath": {
      "version": 1,
      "entries": {
        "coinIndices": {
          "model": "curve:coin-indices",
          "version": 1
        }
      },
      "models": [
        {
          "id": "curve:coin-indices",
          "version": 1,
          "inputs": [
            "coin0",
            "coin1",
            "tokenIn",
            "tokenOut"
          ],
          "outputs": [
            "indexIn",
            "indexOut"
          ],
          "operations": [
            {
              "name": "inIs0",
              "op": "eq",
              "left": {
                "input": "coin0"
              },
              "right": {
                "input": "tokenIn"
              }
            },
            {
              "name": "inIs1",
              "op": "eq",
              "left": {
                "input": "coin1"
              },
              "right": {
                "input": "tokenIn"
              }
            },
            {
              "name": "twoInIs0",
              "op": "mul",
              "left": {
                "constant": "2"
              },
              "right": {
                "local": "inIs0"
              }
            },
            {
              "name": "inSub0",
              "op": "sub",
              "left": {
                "constant": "2"
              },
              "right": {
                "local": "twoInIs0"
              }
            },
            {
              "name": "indexIn",
              "op": "sub",
              "left": {
                "local": "inSub0"
              },
              "right": {
                "local": "inIs1"
              }
            },
            {
              "name": "outIs0",
              "op": "eq",
              "left": {
                "input": "coin0"
              },
              "right": {
                "input": "tokenOut"
              }
            },
            {
              "name": "outIs1",
              "op": "eq",
              "left": {
                "input": "coin1"
              },
              "right": {
                "input": "tokenOut"
              }
            },
            {
              "name": "twoOutIs0",
              "op": "mul",
              "left": {
                "constant": "2"
              },
              "right": {
                "local": "outIs0"
              }
            },
            {
              "name": "outSub0",
              "op": "sub",
              "left": {
                "constant": "2"
              },
              "right": {
                "local": "twoOutIs0"
              }
            },
            {
              "name": "indexOut",
              "op": "sub",
              "left": {
                "local": "outSub0"
              },
              "right": {
                "local": "outIs1"
              }
            }
          ]
        }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
