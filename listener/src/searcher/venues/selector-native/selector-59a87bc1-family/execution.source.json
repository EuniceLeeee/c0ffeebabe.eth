{
  "format": "selector-execution-template/v1",
  "selector": "0x59a87bc1",
  "signature": "function buy(uint256, uint256, address)",
  "domain": "swap",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_59A87BC1_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "zero1-buy",
    "resourceValues": {
      "inputs": [
        "sqlEdge"
      ]
    },
    "projection": {
      "descriptor": {
        "pool": "$target",
        "tokenIn": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenIn"
          ]
        },
        "tokenOut": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenOut"
          ]
        }
      }
    },
    "routes": {
      "target": "$descriptor.pool",
      "directions": [
        {
          "id": "buy",
          "enabled": true,
          "tokenIn": "$descriptor.tokenIn",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": {
            "slotKind": "swap"
          },
          "fields": {
            "pool": "$descriptor.pool"
          }
        }
      ],
      "venue": {
        "kind": "address-pool",
        "pool": {
          "op": "lower",
          "args": [
            {
              "op": "address",
              "args": [
                "$descriptor.pool"
              ]
            }
          ]
        }
      }
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": {
        "directOutput": true
      },
      "protectedAddresses": [
        "$target",
        "$route.tokenIn",
        "$route.tokenOut"
      ],
      "steps": [
        {
          "id": "buy",
          "approval": {
            "token": "$route.tokenIn",
            "spender": "$target",
            "mode": "exact-clear",
            "verifyAllowance": true
          },
          "call": {
            "target": "$target",
            "signature": "function buy(uint256, uint256, address) returns (uint256)",
            "args": [
              {
                "runtime": "amountIn"
              },
              "$minAmountOut",
              "$recipient"
            ],
            "save": {
              "swapOut": 0
            }
          }
        }
      ],
      "effects": [
        {
          "kind": "debit",
          "token": "$route.tokenIn",
          "account": "$executor",
          "equals": {
            "runtime": "amountIn"
          }
        },
        {
          "kind": "credit",
          "token": "$route.tokenOut",
          "account": "$recipient",
          "equals": {
            "runtime": "swapOut"
          },
          "minimum": "$minAmountOut"
        },
        {
          "kind": "unchanged-token",
          "token": "$route.tokenIn",
          "account": "$recipient",
          "when": "$externalRecipient"
        },
        {
          "kind": "unchanged-token",
          "token": "$route.tokenOut",
          "account": "$executor",
          "when": "$externalRecipient"
        },
        {
          "kind": "unchanged-native"
        }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
