{
  "format": "selector-execution-template/v1",
  "selector": "0x1a4d01d2",
  "signature": "function remove_liquidity_one_coin(uint256, int128, uint256)",
  "domain": "swap",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_1A4D01D2_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "curve-remove-liquidity-one-coin",
    "resourceValues": {
      "inputs": [
        "sqlEdge"
      ]
    },
    "projection": {
      "descriptor": {
        "pool": "$target",
        "tokenIn": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenIn"
          ]
        },
        "tokenOut": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenOut"
          ]
        }
      }
    },
    "routes": {
      "target": "$descriptor.pool",
      "directions": [
        {
          "id": "redeem-one-coin",
          "enabled": true,
          "tokenIn": "$descriptor.pool",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": {
            "slotKind": "swap"
          },
          "fields": {
            "pool": "$descriptor.pool"
          }
        }
      ],
      "venue": {
        "kind": "address-pool",
        "pool": {
          "op": "lower",
          "args": [
            {
              "op": "address",
              "args": [
                "$descriptor.pool"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenIn",
              "$descriptor.pool"
            ]
          },
          "error": "standard curve remove_liquidity_one_coin requires pool LP token as input"
        },
        {
          "assert": {
            "op": "not",
            "args": [
              {
                "op": "sameAddress",
                "args": [
                  "$descriptor.tokenOut",
                  "0x0000000000000000000000000000000000000000"
                ]
              }
            ]
          },
          "error": "standard curve remove_liquidity_one_coin requires nonzero ERC20 output"
        }
      ]
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": {
        "directOutput": false
      },
      "protectedAddresses": [
        "$target",
        "$route.tokenIn",
        "$route.tokenOut"
      ],
      "contextChecks": [
        {
          "condition": {
            "op": "not",
            "args": [
              "$externalRecipient"
            ]
          },
          "error": "curve remove_liquidity_one_coin pays caller only"
        },
        {
          "condition": {
            "op": "sameAddress",
            "args": [
              "$route.tokenIn",
              "$target"
            ]
          },
          "error": "standard curve remove_liquidity_one_coin requires pool LP token as input"
        }
      ],
      "steps": [
        {
          "id": "coin0",
          "static": true,
          "call": {
            "target": "$target",
            "signature": "function coins(uint256) view returns (address)",
            "args": [
              0
            ],
            "save": {
              "coin0": 0
            }
          }
        },
        {
          "id": "coin1",
          "static": true,
          "call": {
            "target": "$target",
            "signature": "function coins(uint256) view returns (address)",
            "args": [
              1
            ],
            "save": {
              "coin1": 0
            }
          }
        },
        {
          "id": "index",
          "math": {
            "model": "coinIndex",
            "inputs": {
              "coin1": {
                "runtime": "coin1"
              },
              "tokenOut": {
                "op": "uint",
                "args": [
                  "$route.tokenOut"
                ]
              }
            },
            "outputs": {
              "coinIndex": "coinIndex"
            }
          }
        },
        {
          "id": "redeem",
          "call": {
            "target": "$target",
            "signature": "function remove_liquidity_one_coin(uint256, int128, uint256)",
            "args": [
              {
                "runtime": "amountIn"
              },
              {
                "runtime": "coinIndex"
              },
              "$minAmountOut"
            ]
          }
        }
      ],
      "effects": [
        {
          "kind": "debit",
          "token": "$route.tokenIn",
          "account": "$executor",
          "equals": {
            "runtime": "amountIn"
          }
        },
        {
          "kind": "credit",
          "token": "$route.tokenOut",
          "account": "$recipient",
          "minimum": "$minAmountOut"
        },
        {
          "kind": "unchanged-native"
        }
      ]
    },
    "runtimeMath": {
      "version": 1,
      "entries": {
        "coinIndex": {
          "model": "curve:redeem-coin-index",
          "version": 1
        }
      },
      "models": [
        {
          "id": "curve:redeem-coin-index",
          "version": 1,
          "inputs": [
            "coin1",
            "tokenOut"
          ],
          "outputs": [
            "coinIndex"
          ],
          "operations": [
            {
              "name": "coinIndex",
              "op": "eq",
              "left": {
                "input": "coin1"
              },
              "right": {
                "input": "tokenOut"
              }
            }
          ]
        }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
