{
  "format": "selector-family/v2",
  "selector": "0x2b2dfd2c",
  "signature": "function deposit(uint256, uint32)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_2B2DFD2C_ENABLED"
  },
  "directState": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block",
    "discoveryRuleHash": "245701154c68e8e63c7db26359e882673fcf013f3abdf63de6cc5f73d9022f5f"
  },
  "programs": [
    {
      "type": "independentIdentity",
      "values": {
        "abi": {
          "endpointRead0": [
            "function baseToken() view returns (address)"
          ]
        }
      },
      "binding": {
        "flow": {
          "version": 1,
          "steps": [
            {
              "id": "identity",
              "requirements": {
                "transports": [
                  "eth-call"
                ]
              },
              "requests": [
                {
                  "id": "identity:ep0",
                  "kind": "eth-call",
                  "to": "$target",
                  "data": {
                    "op": "encode",
                    "args": [
                      "endpointRead0",
                      "baseToken()",
                      []
                    ]
                  },
                  "completion": "return-data"
                }
              ],
              "decode": [
                {
                  "let": "r",
                  "value": {
                    "ep0": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            {
                              "op": "decodeCanonical",
                              "args": [
                                "endpointRead0",
                                "baseToken()",
                                {
                                  "op": "get",
                                  "args": [
                                    {
                                      "op": "returned",
                                      "args": [
                                        "identity:ep0"
                                      ]
                                    },
                                    "data"
                                  ]
                                },
                                0
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "return": {
                    "direction": "xwin-deposit",
                    "tokenIn": "$r.ep0",
                    "tokenOut": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            "$target"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "result": "$steps.identity"
        },
        "descriptor": {
          "direction": "xwin-deposit",
          "tokenIn": {
            "op": "address",
            "args": [
              "$binding.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$binding.tokenOut"
            ]
          }
        }
      },
      "checks": [
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenIn",
              "$scope.tokenIn"
            ]
          },
          "error": "identity input differs from edge"
        },
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenOut",
              "$scope.tokenOut"
            ]
          },
          "error": "identity output differs from edge"
        }
      ]
    },
    {
      "type": "execution",
      "resourceValues": {
        "inputs": [
          "sqlEdge"
        ]
      },
      "routes": {
        "directions": [
          {
            "id": "mint",
            "enabled": true,
            "tokenIn": "$descriptor.tokenIn",
            "tokenOut": "$descriptor.tokenOut",
            "taxonomy": {
              "slotKind": "protocol",
              "protocolAction": "wrap"
            }
          }
        ],
        "resource": {
          "target": "$descriptor.target"
        }
      },
      "execution": {
        "version": 2,
        "requireCanonicalSource": true,
        "settlement": {
          "directOutput": false
        },
        "protectedAddresses": [
          "$target",
          "$route.tokenIn"
        ],
        "contextChecks": [
          {
            "condition": {
              "op": "not",
              "args": [
                "$externalRecipient"
              ]
            },
            "error": "xWIN deposit mints to caller"
          }
        ],
        "steps": [
          {
            "id": "deposit",
            "approval": {
              "token": "$route.tokenIn",
              "spender": "$target",
              "mode": "exact-clear",
              "requireBool": true,
              "verifyAllowance": true
            },
            "call": {
              "target": "$target",
              "signature": "function deposit(uint256, uint32) returns (uint256)",
              "args": [
                {
                  "runtime": "amountIn"
                },
                0
              ]
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "token": "$route.tokenIn",
            "account": "$executor",
            "equals": {
              "runtime": "amountIn"
            }
          },
          {
            "kind": "credit",
            "token": "$route.tokenOut",
            "account": "$executor",
            "minimum": "$minAmountOut"
          },
          {
            "kind": "unchanged-native"
          }
        ]
      },
      "refreshPolicy": "on-touch",
      "sourceRefreshPolicy": "on-touch",
      "projection": {
        "descriptor": {
          "tokenIn": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenOut"
            ]
          }
        }
      }
    }
  ]
}
