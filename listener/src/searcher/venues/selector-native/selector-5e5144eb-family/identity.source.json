{
  "format": "identity-options/v1",
  "selector": "0x5e5144eb",
  "signature": "function change(address, address, uint256, uint256)",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_5E5144EB_ENABLED"
  },
  "options": [
    {
      "id": "astra-change",
      "tokenIn": "$scope.tokenIn",
      "tokenOut": "$scope.tokenOut",
      "checks": [
        {
          "call": "function changesEnabled() view returns (bool)",
          "equals": true
        },
        {
          "call": "function weights(address) view returns (uint256)",
          "args": [
            "$scope.tokenIn"
          ],
          "min": 1
        },
        {
          "call": "function weights(address) view returns (uint256)",
          "args": [
            "$scope.tokenOut"
          ],
          "min": 1
        }
      ]
    }
  ]
}
