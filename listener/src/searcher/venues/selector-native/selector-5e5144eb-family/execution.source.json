{
  "format": "selector-execution-template/v1",
  "selector": "0x5e5144eb",
  "signature": "function change(address, address, uint256, uint256)",
  "domain": "protocol",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_5E5144EB_ENABLED"
  },
  "state": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block"
  },
  "template": {
    "id": "astra-change",
    "resourceValues": {
      "inputs": [
        "sqlEdge"
      ]
    },
    "projection": {
      "descriptor": {
        "tokenIn": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenIn"
          ]
        },
        "tokenOut": {
          "op": "address",
          "args": [
            "$sqlEdge.tokenOut"
          ]
        }
      }
    },
    "routes": {
      "directions": [
        {
          "id": "change",
          "enabled": true,
          "tokenIn": "$descriptor.tokenIn",
          "tokenOut": "$descriptor.tokenOut",
          "taxonomy": {
            "slotKind": "protocol",
            "protocolAction": "convert"
          }
        }
      ],
      "resource": {
        "target": "$descriptor.target"
      }
    },
    "execution": {
      "version": 2,
      "requireCanonicalSource": true,
      "settlement": {
        "directOutput": false
      },
      "protectedAddresses": [
        "$target",
        "$route.tokenIn",
        "$route.tokenOut"
      ],
      "contextChecks": [
        {
          "condition": {
            "op": "not",
            "args": [
              "$externalRecipient"
            ]
          },
          "error": "astra change pays caller only"
        }
      ],
      "steps": [
        {
          "id": "change",
          "approval": {
            "token": "$route.tokenIn",
            "spender": "$target",
            "mode": "exact-clear",
            "requireBool": true,
            "verifyAllowance": true
          },
          "call": {
            "target": "$target",
            "signature": "function change(address, address, uint256, uint256) returns (uint256)",
            "args": [
              "$route.tokenIn",
              "$route.tokenOut",
              {
                "runtime": "amountIn"
              },
              "$minAmountOut"
            ]
          }
        }
      ],
      "effects": [
        {
          "kind": "debit",
          "token": "$route.tokenIn",
          "account": "$executor",
          "equals": {
            "runtime": "amountIn"
          }
        },
        {
          "kind": "credit",
          "token": "$route.tokenOut",
          "account": "$executor",
          "minimum": "$minAmountOut"
        },
        {
          "kind": "unchanged-native"
        }
      ]
    },
    "refreshPolicy": "on-touch",
    "sourceRefreshPolicy": "on-touch"
  }
}
