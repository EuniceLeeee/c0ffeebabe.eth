{
  "format": "selector-family/v2",
  "selector": "0xbd6015b4",
  "signature": "function sellBase(address)",
  "domain": "swap",
  "activation": {
    "enabled": true,
    "envKey": "SEARCHER_FAMILY_SELECTOR_BD6015B4_ENABLED"
  },
  "directState": {
    "pool": "edge.poolAddress",
    "assets": [
      "edge.tokenIn",
      "edge.tokenOut"
    ],
    "watch": "pool-touch",
    "on": [
      "call-target",
      "log-emitter",
      "asset-transfer-endpoint"
    ],
    "unclassifiedWatch": "each-block",
    "discoveryRuleHash": "291ed9c76bca4acbe25c65ddfadf12c4d93b753ed48991b8a3bbf0af4d732c41"
  },
  "programs": [
    {
      "type": "independentIdentity",
      "values": {
        "abi": {
          "endpointRead0": [
            "function _BASE_TOKEN_() view returns (address)"
          ],
          "endpointRead1": [
            "function _QUOTE_TOKEN_() view returns (address)"
          ]
        }
      },
      "binding": {
        "flow": {
          "version": 1,
          "steps": [
            {
              "id": "identity",
              "requirements": {
                "transports": [
                  "eth-call"
                ]
              },
              "requests": [
                {
                  "id": "identity:ep0",
                  "kind": "eth-call",
                  "to": "$target",
                  "data": {
                    "op": "encode",
                    "args": [
                      "endpointRead0",
                      "_BASE_TOKEN_()",
                      []
                    ]
                  },
                  "completion": "return-data"
                },
                {
                  "id": "identity:ep1",
                  "kind": "eth-call",
                  "to": "$target",
                  "data": {
                    "op": "encode",
                    "args": [
                      "endpointRead1",
                      "_QUOTE_TOKEN_()",
                      []
                    ]
                  },
                  "completion": "return-data"
                }
              ],
              "decode": [
                {
                  "let": "r",
                  "value": {
                    "ep0": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            {
                              "op": "decodeCanonical",
                              "args": [
                                "endpointRead0",
                                "_BASE_TOKEN_()",
                                {
                                  "op": "get",
                                  "args": [
                                    {
                                      "op": "returned",
                                      "args": [
                                        "identity:ep0"
                                      ]
                                    },
                                    "data"
                                  ]
                                },
                                0
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    "ep1": {
                      "op": "lower",
                      "args": [
                        {
                          "op": "address",
                          "args": [
                            {
                              "op": "decodeCanonical",
                              "args": [
                                "endpointRead1",
                                "_QUOTE_TOKEN_()",
                                {
                                  "op": "get",
                                  "args": [
                                    {
                                      "op": "returned",
                                      "args": [
                                        "identity:ep1"
                                      ]
                                    },
                                    "data"
                                  ]
                                },
                                0
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "return": {
                    "direction": "sell-base",
                    "tokenIn": "$r.ep0",
                    "tokenOut": "$r.ep1"
                  }
                }
              ]
            }
          ],
          "result": "$steps.identity"
        },
        "descriptor": {
          "direction": "sell-base",
          "tokenIn": {
            "op": "address",
            "args": [
              "$binding.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$binding.tokenOut"
            ]
          }
        }
      },
      "checks": [
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenIn",
              "$scope.tokenIn"
            ]
          },
          "error": "identity input differs from edge"
        },
        {
          "assert": {
            "op": "sameAddress",
            "args": [
              "$descriptor.tokenOut",
              "$scope.tokenOut"
            ]
          },
          "error": "identity output differs from edge"
        }
      ]
    },
    {
      "type": "execution",
      "resourceValues": {
        "inputs": [
          "sqlEdge"
        ]
      },
      "routes": {
        "target": "$descriptor.pool",
        "directions": [
          {
            "id": "sell-base",
            "enabled": true,
            "tokenIn": "$descriptor.tokenIn",
            "tokenOut": "$descriptor.tokenOut",
            "taxonomy": {
              "slotKind": "swap"
            },
            "fields": {
              "pool": "$descriptor.pool"
            }
          }
        ],
        "venue": {
          "kind": "address-pool",
          "pool": {
            "op": "lower",
            "args": [
              {
                "op": "address",
                "args": [
                  "$descriptor.pool"
                ]
              }
            ]
          }
        }
      },
      "execution": {
        "version": 2,
        "requireCanonicalSource": true,
        "settlement": {
          "directOutput": true
        },
        "protectedAddresses": [
          "$target",
          "$route.tokenIn",
          "$route.tokenOut"
        ],
        "steps": [
          {
            "id": "transferInput",
            "call": {
              "target": "$route.tokenIn",
              "signature": "function transfer(address, uint256) returns (bool)",
              "args": [
                "$target",
                {
                  "runtime": "amountIn"
                }
              ]
            }
          },
          {
            "id": "sell",
            "call": {
              "target": "$target",
              "signature": "function sellBase(address) returns (uint256)",
              "args": [
                "$recipient"
              ],
              "save": {
                "sellOut": 0
              }
            }
          }
        ],
        "effects": [
          {
            "kind": "debit",
            "token": "$route.tokenIn",
            "account": "$executor",
            "equals": {
              "runtime": "amountIn"
            }
          },
          {
            "kind": "credit",
            "token": "$route.tokenOut",
            "account": "$recipient",
            "equals": {
              "runtime": "sellOut"
            },
            "minimum": "$minAmountOut"
          },
          {
            "kind": "unchanged-token",
            "token": "$route.tokenIn",
            "account": "$recipient",
            "when": "$externalRecipient"
          },
          {
            "kind": "unchanged-token",
            "token": "$route.tokenOut",
            "account": "$executor",
            "when": "$externalRecipient"
          },
          {
            "kind": "unchanged-native"
          }
        ]
      },
      "refreshPolicy": "on-touch",
      "sourceRefreshPolicy": "on-touch",
      "projection": {
        "descriptor": {
          "pool": "$target",
          "tokenIn": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenIn"
            ]
          },
          "tokenOut": {
            "op": "address",
            "args": [
              "$sqlEdge.tokenOut"
            ]
          }
        }
      }
    }
  ]
}
