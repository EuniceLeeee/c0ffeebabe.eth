  "identity": {
    "definition": {
      "version": 1,
      "abi": {
        "goldx": [
          "function unit() view returns (uint256)"
        ]
      },
      "constants": {},
      "expressions": {},
      "identity": {
        "select": [
          {
            "return": "active-unit"
          }
        ],
        "stages": {
          "active-unit": {
            "requirements": {
              "transports": [
                "get-code",
                "eth-call"
              ]
            },
            "requests": [
              {
                "id": "identity-code",
                "kind": "get-code",
                "address": {
                  "op": "address",
                  "args": [
                    "$candidate.target"
                  ]
                }
              },
              {
                "id": "identity-unit",
                "kind": "eth-call",
                "to": {
                  "op": "address",
                  "args": [
                    "$candidate.target"
                  ]
                },
                "data": {
                  "op": "encode",
                  "args": [
                    "goldx",
                    "unit",
                    []
                  ]
                },
                "completion": "return-data"
              }
            ],
            "decode": [
              {
                "let": "codeHash",
                "value": {
                  "op": "codeHash",
                  "args": [
                    {
                      "op": "code",
                      "args": [
                        "identity-code"
                      ]
                    }
                  ]
                }
              },
              {
                "let": "unit",
                "value": {
                  "op": "uint",
                  "args": [
                    {
                      "op": "decode",
                      "args": [
                        "goldx",
                        "unit",
                        {
                          "op": "get",
                          "args": [
                            {
                              "op": "returned",
                              "args": [
                                "identity-unit"
                              ]
                            },
                            "data"
                          ]
                        },
                        0
                      ]
                    }
                  ]
                }
              },
              {
                "return": {
                  "codeHash": "$codeHash",
                  "unit": "$unit"
                }
              }
            ]
          }
        },
        "decide": [
          {
            "return": {
              "status": "continue"
            },
            "when": {
              "op": "not",
              "args": [
                {
                  "op": "defined",
                  "args": [
                    "$evidence"
                  ]
                }
              ]
            }
          },
          {
            "return": {
              "status": "chain-proven-rejected",
              "reasonCode": "goldx_unit_inactive",
              "evidenceRequestIds": [
                "active-unit-mint"
              ]
            },
            "when": {
              "op": "lte",
              "args": [
                "$evidence.unit",
                {
                  "op": "uint",
                  "args": [
                    "0"
                  ]
                }
              ]
            }
          },
          {
            "return": {
              "status": "verified",
              "identity": {
                "familyId": "$profile.familyId",
                "lineageId": "$profile.lineageId",
                "subject": {
                  "op": "address",
                  "args": [
                    "$candidate.target"
                  ]
                },
                "provenance": [
                  {
                    "kind": "goldx-active-unit-proof",
                    "subject": {
                      "op": "address",
                      "args": [
                        "$candidate.target"
                      ]
                    },
                    "evidenceHash": {
                      "op": "hash",
                      "args": [
                        {
                          "codeHash": "$evidence.codeHash",
                          "unit": "$evidence.unit"
                        }
                      ]
                    }
                  }
                ],
                "unit": "$evidence.unit"
              }
            }
          }
        ]
      }
    },
    "key": {
      "op": "lower",
      "args": [
        {
          "op": "address",
          "args": [
            "$identity.subject"
          ]
        }
      ]
    }
  },
  "instance": {
    "key": {
      "op": "lower",
      "args": [
