        "op": "lower",
        "args": [
          {
            "op": "address",
            "args": [
              "$descriptor.collateral"
            ]
          }
        ]
      },
      "receipt": {
        "op": "lower",
        "args": [
          {
            "op": "address",
            "args": [
              "$descriptor.receipt"
            ]
          }
        ]
      },
      "quoteSemantics": "floor(amount*unit/1e18)"
    }
  },
  "routes": {
    "target": "$descriptor.target",
    "bindingKey": {
      "op": "lower",
      "args": [
        {
          "op": "address",
          "args": [
            "$descriptor.target"
          ]
        }
      ]
    },
    "directions": [
      {
        "id": "mint",
