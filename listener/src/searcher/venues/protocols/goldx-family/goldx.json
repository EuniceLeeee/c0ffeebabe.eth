                      "goldx",
                      "unit",
                      {
                        "op": "get",
                        "args": [
                          {
                            "op": "returned",
                            "args": [
                              "quote-unit"
                            ]
                          },
                          "data"
                        ]
                      },
                      0
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "result": {
        "op": "model",
        "args": [
          "goldxUnit",
          {
            "amountIn": "$amountIn",
            "unit": "$steps.unit"
          }
        ]
      }
    }
  },
