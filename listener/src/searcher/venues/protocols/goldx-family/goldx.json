  "standard": {
    "id": "active-unit-mint",
    "lineageId": "goldx:active-unit-mint",
    "abi": {
      "goldx": [
        "function unit() view returns (uint256)",
        "function mint(address receiver,uint256 amount)"
      ]
    },
    "constants": {
      "paxg": "0x45804880De22913dAFE09f4980848ECE6EcbAf78",
      "goldx": "0x355C665e101B9DA58704A8fDDb5FeeF210eF20c0",
      "sample": "1000000000000000000",
      "maxUint256": "115792089237316195423570985008687907853269984665640564039457584007913129639935"
    },
    "expressions": {},
    "match": true,
    "context": {},
    "boundState": "$descriptor",
    "identityKind": "standalone-contract",
    "assertions": [
      {
        "assert": {
          "op": "eq",
          "args": [
            "$route.direction",
            "mint"
          ]
        },
        "error": "GOLDx route is incompatible with its mint descriptor"
      },
      {
        "assert": {
          "op": "sameAddress",
          "args": [
            "$route.tokenIn",
            "$descriptor.collateral"
          ]
        },
        "error": "GOLDx route is incompatible with its mint descriptor"
      },
      {
        "assert": {
          "op": "sameAddress",
          "args": [
            "$route.tokenOut",
            "$descriptor.receipt"
          ]
        },
        "error": "GOLDx route is incompatible with its mint descriptor"
      },
      {
        "assert": {
          "op": "eq",
          "args": [
            "$route.adapterId",
            "goldx-mint"
          ]
        },
        "error": "GOLDx route is incompatible with its mint descriptor"
      }
    ],
    "pricing": {
      "mutationAddresses": [
        "$descriptor.target"
      ],
      "refreshPolicy": "on-touch",
      "requirements": {
        "transports": [
          "eth-call"
        ]
      },
      "dependencies": [
        "$descriptor.target",
        "$descriptor.collateral",
        "$descriptor.receipt"
      ]
    },
    "exact": {
      "methodId": "goldx-unit",
      "requirements": {
        "transports": [
          "eth-call"
        ]
      },
      "retainReadEvidence": true,
      "checks": [
        {
          "assert": {
            "op": "lte",
            "args": [
              "$amountIn",
              {
                "op": "uint",
                "args": [
                  "$constants.maxUint256"
                ]
              }
            ]
          },
          "error": "GOLDx exact input exceeds uint256"
        },
        {
          "assert": {
            "op": "not",
            "args": [
              {
                "op": "defined",
                "args": [
                  "$trialState"
                ]
              }
            ]
          },
          "error": "GOLDx collateral transfer, mint fee and supply transition model is unproven"
        },
        {
          "assert": {
            "op": "not",
            "args": [
              {
                "op": "defined",
                "args": [
                  "$prefix"
                ]
              }
            ]
          },
          "error": "GOLDx local state transition model is unproven"
        }
      ],
      "evidence": {
        "kind": "goldx-unit-quote",
        "source": "$source",
        "target": "$descriptor.target",
        "unit": {
          "op": "if",
          "args": [
            {
              "op": "eq",
              "args": [
                "$amountIn",
                {
                  "op": "uint",
                  "args": [
                    "0"
                  ]
                }
              ]
            },
            {
              "op": "uint",
              "args": [
                "0"
              ]
            },
            "$steps.unit"
          ]
        },
        "amountIn": "$amountIn",
        "amountOut": "$amountOut",
        "bindingFingerprint": "$route.bindingRef.fingerprint"
      }
    },
    "readPrograms": {
      "quote": {
        "requests": [
          {
            "id": "$requestId",
            "kind": "eth-call",
            "to": "$descriptor.target",
            "data": {
              "op": "encode",
              "args": [
                "goldx",
                "unit",
                []
              ]
            },
            "completion": "return-data"
          }
        ],
        "result": {
          "op": "model",
          "args": [
            "goldxUnit",
            {
              "amountIn": "$amountIn",
              "unit": {
                "op": "uint",
                "args": [
                  {
                    "op": "decode",
                    "args": [
                      "goldx",
                      "unit",
                      {
                        "op": "get",
                        "args": [
                          {
                            "op": "returned",
                            "args": [
                              "$requestId"
                            ]
                          },
                          "data"
                        ]
                      },
                      0
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "execution": {
      "version": 1,
      "settlement": {
        "directOutput": false
      },
      "protectedAddresses": [
        "$descriptor.target"
      ],
      "approval": {
        "token": "$route.tokenIn",
        "spender": "$descriptor.target",
        "mode": "ensure"
      },
      "call": {
        "target": "$descriptor.target",
        "signature": "function mint(address,uint256)",
        "args": [
          "$executor",
          {
            "runtime": "amountIn"
          }
        ]
      },
      "effects": [
        {
          "kind": "debit",
          "token": "$route.tokenIn",
          "account": "$executor",
          "equals": {
            "runtime": "amountIn"
          }
        },
        {
          "kind": "credit",
          "token": "$route.tokenOut",
          "account": "$executor",
          "minimum": 1
        }
      ]
    },
    "inputs": [
      "trialState",
      "prefix"
    ]
  },
  "modules": {
    "math": {
      "version": 1,
      "entries": {
        "goldxUnit": {
          "model": "goldx:unit-quote",
          "version": 1
        }
      }
    },
    "quoteFlow": {
      "version": 1,
      "sourceKind": "local-math",
      "localStateUnsupportedReason": "GOLDx collateral transfer, mint fee and supply transition model is unproven",
      "steps": [
        {
          "id": "unit",
          "requirements": {
            "transports": [
              "eth-call"
            ]
