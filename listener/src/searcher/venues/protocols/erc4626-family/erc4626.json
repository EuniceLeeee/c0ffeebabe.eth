        "execution": {
          "forwardArgs": ["$base.sampleAssets", {"op": "address", "args": ["$constants.actor"]}],
          "reverseArgs": [
            "$base.sampleShares",
            {"op": "address", "args": ["$constants.actor"]},
            {"op": "address", "args": ["$constants.actor"]}
          ]
