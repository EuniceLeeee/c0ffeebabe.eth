{
  "name": "@aloha/searcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "acceptance/*",
    "apps/*",
    "families/*",
    "packages/*",
    "runtime/*",
    "specs/*",
    "strategies/*",
    "tools/*",
    "tools/reference-only/*"
  ],
  "scripts": {
    "build": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run typecheck --workspaces --if-present",
    "architecture-boundary": "npm run check --workspace @aloha/boundary-gate",
    "generate-release-role-manifest": "npm run generate --workspace @aloha/release-role-manifest",
    "check-release-role-manifest": "npm run generate --workspace @aloha/release-role-manifest -- --check"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "typescript": "5.9.3"
  }
}
